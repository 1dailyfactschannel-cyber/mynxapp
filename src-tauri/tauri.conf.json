{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mynx",
  "version": "1.2.2",
  "identifier": "com.matt.mynx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mynx",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' asset: data:",
        "connect-src": "'self'",
        "script-src": "'self' 'unsafe-eval'"
      },
      "capabilities": [
        {
          "identifier": "main",
          "description": "Main app capabilities",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "shell:allow-open",
            "os:allow-platform",
            "clipboard-manager:allow-write-text",
            "dialog:allow-open",
            "global-shortcut:allow-register",
            "global-shortcut:allow-unregister",
            "global-shortcut:allow-is-registered",
            "core:window:allow-minimize",
            "core:window:allow-close",
            "core:window:allow-start-dragging",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-unminimize",
            "core:window:allow-set-focus"
          ]
        }
      ]
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Mynx",
    "shortDescription": "Offline password manager",
    "longDescription": "Mynx is an offline-first password manager with encrypted local vault.",
    "copyright": "Copyright © 2026 Mynx",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/installer.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  }
}
