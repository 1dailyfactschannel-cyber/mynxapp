    // Tutorial
    tutOpen: "Tutorial",
    tutTitle: "How Mynx works",
    tutDesc: "Guide and answers to common questions",
    tutTabGuide: "Guide",
    tutTabFaq: "FAQ",
    tutTabKb: "Knowledge base",
    kbSearch: "Search the guide...",
    kbEmpty: "Nothing found. Try another query.",
    tutFlowPassword: "Master password",
    tutFlowKdf: "Key derivation",
    tutFlowVault: "Vault",
    tutStep1T: "Create a vault",
    tutStep1D: "Set a name and a strong master password on first launch. The vault file and a device key are created in the vaults folder next to the app.",
    tutStep2T: "Add entries",
    tutStep2D: "Click New Entry or press Ctrl+Shift+A from anywhere. Title, login and password are encrypted and saved automatically.",
    tutStep3T: "Copy & auto-type",
    tutStep3D: "Copy a password from an entry card вЂ” it goes to an encrypted in-app buffer, never to the system clipboard. Press Ctrl+Shift+V to type it into the focused field. Or press Ctrl+Alt+A in any app: Mynx finds a matching entry by the window title and types the login and password.",
    tutStep4T: "Back up",
    tutStep4D: "Settings в†’ Export creates an encrypted .spbackup file that needs only your master password. Keep it on a USB drive.",
    tutStep5T: "Save the Emergency Kit",
    tutStep5D: "Settings в†’ Emergency Kit generates a QR code with your device key. Vault file + this QR + master password = recovery.",
    tutStep6T: "Use custom fields",
    tutStep6D: "In an entry detail or Quick Add, click the '+' button to add custom fields: notes, hidden values, email, URL, number, or date.",
    tutStep7T: "Manage attachments",
    tutStep7D: "Open Attachments from the sidebar to create folders and upload files up to 300 MB. Files are stored with your vault.",
    tutStep8T: "Use trash and backups",
    tutStep8D: "Deleted entries go to Trash with configurable retention. Enable auto-backup in Settings to automatically copy your vault.",
    tutStep9T: "Memory protection",
    tutStep9D: "Mynx blocks crash dumps and wipes encryption keys from RAM when the window is closed to the tray or the app exits. Configurable in Settings в†’ Security.",
    tutFaq1Q: "Where is my data stored?",
    tutFaq1A: "Only on this computer, in the vaults folder next to the application. Nothing leaves the device вЂ” Mynx works fully offline.",
    tutFaq2Q: "I forgot my master password. What now?",
    tutFaq2A: "It cannot be recovered: without the password the vault cannot be decrypted. The only way back is the vault file together with the device key (.safepass.dk or the Emergency Kit QR) plus your password. Without them the data is lost.",
    tutFaq3Q: "What is the device key?",
    tutFaq3A: "A random 16-byte file created together with the vault. The encryption key is derived from your master password AND this key, so the vault file alone cannot be decrypted.",
    tutFaq4Q: "How does auto-type work?",
    tutFaq4A: "Click into the login field in any app or browser and press Ctrl+Alt+A. Mynx matches an entry by the window title or its URL host and types username, Tab and password as if from a keyboard вЂ” the clipboard is never used. If several entries match, a picker opens.",
    tutFaq5Q: "What about the clipboard?",
    tutFaq5A: "Copied secrets never reach it. They are stored in an encrypted buffer inside the app and typed directly into the focused field with Ctrl+Shift+V (configurable). The buffer is single-use.",
    tutFaq6Q: "How do I move to another computer?",
    tutFaq6A: "Copy the .safepass file and its .safepass.dk from the vaults folder into the same folder next to the app on the new machine, then unlock with your master password.",
    tutFaq7Q: "How do I use custom fields?",
    tutFaq7A: "Open an entry or Quick Add, click the '+' button at the bottom, choose a field type (text, hidden, email, URL, number, date), and fill in the label and value.",
    tutFaq8Q: "Can I attach files to entries?",
    tutFaq8A: "Yes, use the Attachments section in the sidebar. Create folders and upload files up to 300 MB. They are stored with your vault data.",
    tutFaq9Q: "What happens when I delete an entry?",
    tutFaq9A: "It goes to the Trash. You can restore it or delete it permanently. The retention period is configurable in Settings.",
    tutFaq10Q: "How does auto-backup work?",
    tutFaq10A: "Enable it in Settings в†’ Data. Mynx will automatically copy your vault file and device key to the backup folder at the interval you set.",
    tutFaq11Q: "Why is the vault locked when I close the window to the tray?",
    tutFaq11A: "That is memory protection: Mynx wipes the encryption keys from RAM so passwords cannot leak via memory dumps or the swap file. You can disable this in Settings в†’ Security if you prefer the vault to stay unlocked in the tray.",
    tutFaq12Q: "Auto-type does not find my entry. What should I do?",
    tutFaq12A: "The entry title or URL host must appear in the target window title (e.g. rename the entry to \"Epic Games\"). Otherwise pick the entry manually in the list that opens when there is no unique match.",

    // Misc
    settings: "Settings",
    lock: "Lock",
    close: "Close",
    browse: "Browse",
    languageName: "English",
  },

  ru: {
